[flake8]
# Максимально допустимая длина строки (по PEP8 — 79, но для веб-разработки часто ставят 88–120)
max-line-length = 120

# Исключаем системные папки, виртуальное окружение и автосгенерированные миграции Alembic
exclude =
    .git,
    __pycache__,
    .venv,
    env,
    venv,
    alembic/versions/*,
    alembic/env.py

# Игнорируем некоторые специфические правила:
# W503 — перенос строки перед бинарным оператором (устарело, в новом PEP8 это норма)
# E203 — пробел перед двоеточием (часто конфликтует с форматировщиком Black)
ignore = W503, E203

# Максимальная цикломатическая сложность функций (рекомендуемое значение 10)
max-complexity = 10
